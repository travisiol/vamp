# ---- Chain (defaults are Robinhood Chain mainnet, chain id 4663) ----
# NEXT_PUBLIC_CHAIN_ID=4663
# NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# NEXT_PUBLIC_RPC_FALLBACKS=https://robinhood-rpc.publicnode.com
# NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# NEXT_PUBLIC_PONS_APP_URL=https://www.ponsfamily.com

# ---- Pons V2 (verified on chain 2026-09-18; override only to point at another factory) ----
# NEXT_PUBLIC_PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# NEXT_PUBLIC_PONS_FORWARDER=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948
# NEXT_PUBLIC_PONS_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
# NEXT_PUBLIC_PONS_CONFIG_ID=0

# ---- CONFIGURE: optional integrations ----
# WalletConnect Cloud project id — without it only injected (browser) wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Pinata JWT (server only) — without it the editor takes an image URL instead of a file upload.
PINATA_JWT=
# Public site URL for metadata.
NEXT_PUBLIC_SITE_URL=https://vamp.example

# ---- Scan windows (blocks; ~10 blocks per second) ----
# VAMP_SCAN_BLOCKS=300000
# VAMP_DASHBOARD_BLOCKS=30000000
